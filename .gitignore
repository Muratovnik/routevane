# Go
/routing-agent
/routing-agent.exe
*.test
*.out
/coverage/

# Frontend
/web/node_modules/
/web/.nuxt/
/web/.output/
/web/dist/
/web/coverage/
/desktop/node_modules/

# Generated Nuxt public output embedded by the Go HTTP boundary. The tracked
# marker keeps the package compilable until tools/dev.ps1 generates and syncs it.
/internal/infrastructure/httpapi/ui/*
!/internal/infrastructure/httpapi/ui/
!/internal/infrastructure/httpapi/ui/routevane-ui.marker

# Runtime state
/data/
*.db
*.db-shm
*.db-wal
*.log

# Tool caches
/.cache/
/.tools/
__pycache__/

# Optional client preferences are local by default. Reviewed, portable shared
# settings can be deliberately added; settings.local.json stays private.
/.claude/settings.json
/.codex/config.toml

# Agent-local state
/.agents/local/
/.claude/settings.local.json
/.codex/workflow.toml
/.env
/.env.production
/.private/
/AGENTS.local.md
/.codex-log/
/.serena/
/.impeccable/
/.playwright-mcp/
# Agent working output: review reports and scratch files. Untracked but unignored,
# it showed up in every status listing and was one `git add -A` from the history.
/tmp/
/docs/plans/private/
/private.key

# Editors and OS
/.idea/
/.vscode/
.DS_Store
Thumbs.db
