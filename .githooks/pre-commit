#!/bin/sh
set -eu

root=$(git rev-parse --show-toplevel)
# `git commit -a` and `git commit <paths>` prepare a separate index and hand
# it to this hook in GIT_INDEX_FILE; the default index still holds the old
# state. The audit and the subsystem routing must judge the index that is being
# committed, so it is kept for those two commands only. Git runs the hook from
# the top of the working tree, so a relative value is resolved against it.
commit_index=${GIT_INDEX_FILE-}
case $commit_index in
  '' | /* | [A-Za-z]:[\\/]*) ;;
  *) commit_index=$root/$commit_index ;;
esac
# Every other child starts from a clean Git environment, so throwaway
# repositories and worktrees cannot inherit this repository's index.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX

with_commit_index() {
  if [ -n "$commit_index" ]; then
    env GIT_INDEX_FILE="$commit_index" "$@"
  else
    "$@"
  fi
}

python "$root/tools/doctor.py"
with_commit_index python "$root/.github/relkit.pyz" audit --staged
# Every change routes, deletions and both sides of a rename included: removing
# a Go file can break the Go build as surely as editing one.
staged=$(with_commit_index git -C "$root" diff --cached --name-only --no-renames)

if printf '%s\n' "$staged" | grep -Eq '^(cmd/|internal/|go\.(mod|sum)$|tools/|\.githooks/)'; then
  pwsh -NoLogo -NoProfile -File "$root/tools/dev.ps1" check-go
fi

if printf '%s\n' "$staged" | grep -Eq '^(web/|tools/|\.githooks/)'; then
  pwsh -NoLogo -NoProfile -File "$root/tools/dev.ps1" check-web
fi

if printf '%s\n' "$staged" | grep -Eq '^(desktop/|tools/|\.githooks/)'; then
  pwsh -NoLogo -NoProfile -File "$root/tools/dev.ps1" check-desktop
fi
