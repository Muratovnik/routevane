{
  "name": "@routevane/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.17.0 <13"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "@modelcontextprotocol/client": "2.3.1",
    "@nuxt/cli": "4.0.1",
    "@nuxt/devtools": "4.0.0-beta.4",
    "@nuxt/devtools-kit": "4.0.0-beta.4",
    "esbuild": "0.28.2",
    "handlebars": "4.7.10",
    "playwright": "1.63.0",
    "playwright-core": "1.63.0",
    "serialize-javascript": "7.1.2",
    "shell-quote": "1.12.0",
    "source-map-js": "1.2.2",
    "braces": "npm:@dieub/braces-depth-guard@3.0.3-pn.3",
    "node-forge": "$node-forge"
  },
  "scripts": {
    "build": "npm run typecheck && nuxt generate",
    "dev": "python ../tools/dev_server.py",
    "format": "prettier . --write",
    "generate": "npm run build",
    "lint": "eslint .",
    "lint:format": "prettier . --check",
    "lint:styles": "stylelint \"**/*.{css,vue}\"",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview",
    "security": "python ../tools/check_web_derivatives.py && node --test ../tools/test_web_dependency_security.cjs ../third_party/node-forge/test/security.cjs && npm audit --package-lock-only --include=dev --include=optional --include=peer --audit-level=high",
    "test:browser": "playwright test",
    "test:dev": "playwright test --config playwright.dev.config.ts",
    "test:unit": "vitest run",
    "typecheck": "nuxt typecheck",
    "check": "npm run security && npm run typecheck && npm run lint && npm run lint:styles && npm run lint:format && npm run test:unit && npm run build"
  },
  "dependencies": {
    "@nuxt/ui": "4.12.0",
    "@vueuse/core": "15.0.0",
    "@vueuse/integrations": "15.0.0",
    "nuxt": "4.6.3",
    "reka-ui": "2.11.0",
    "sortablejs": "1.15.7",
    "valibot": "1.5.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "node-forge": "file:../third_party/node-forge"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@nuxt/eslint": "1.17.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/sortablejs": "1.15.9",
    "@vitejs/devtools-kit": "0.8.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/eslint-plugin": "1.6.28",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.0",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-prefer-arrow-functions": "3.10.2",
    "eslint-plugin-security": "4.2.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-vuejs-accessibility": "2.6.3",
    "postcss-html": "2.0.0",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-vue": "2.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "vitest-browser-vue": "3.1.0",
    "vue-tsc": "3.3.13"
  }
}
