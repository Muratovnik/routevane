{
  "name": "@routevane/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.17.0 <12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  },
  "scripts": {
    "build": "npm run typecheck && nuxt generate",
    "dev": "nuxt dev",
    "format": "prettier . --write",
    "generate": "npm run build",
    "lint": "eslint . --max-warnings 0",
    "lint:format": "prettier . --check",
    "lint:styles": "stylelint \"**/*.{css,vue}\"",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview",
    "test:browser": "playwright test",
    "test:unit": "vitest run",
    "typecheck": "nuxt typecheck",
    "check": "npm run typecheck && npm run lint && npm run lint:styles && npm run lint:format && npm run test:unit && npm run build"
  },
  "dependencies": {
    "@vueuse/core": "14.4.0",
    "nuxt": "4.5.2",
    "reka-ui": "2.10.4",
    "valibot": "1.4.2",
    "vue": "3.5.41",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@nuxt/eslint": "1.17.0",
    "@playwright/test": "1.62.1",
    "@types/node": "26.1.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-security": "4.0.1",
    "eslint-plugin-sonarjs": "4.2.0",
    "eslint-plugin-vuejs-accessibility": "2.6.0",
    "happy-dom": "20.11.6",
    "postcss-html": "2.0.0",
    "prettier": "3.9.6",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-vue": "2.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.10"
  }
}
