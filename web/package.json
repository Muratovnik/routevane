{
  "name": "@routevane/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.17.0 <12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  },
  "scripts": {
    "build": "npm run typecheck && nuxt generate",
    "dev": "python ../tools/dev_server.py",
    "format": "prettier . --write",
    "generate": "npm run build",
    "lint": "eslint .",
    "lint:format": "prettier . --check",
    "lint:styles": "stylelint \"**/*.{css,vue}\"",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview",
    "test:browser": "playwright test",
    "test:dev": "playwright test --config playwright.dev.config.ts",
    "test:unit": "vitest run",
    "typecheck": "nuxt typecheck",
    "check": "npm run typecheck && npm run lint && npm run lint:styles && npm run lint:format && npm run test:unit && npm run build"
  },
  "dependencies": {
    "@nuxt/ui": "4.11.1",
    "@vueuse/core": "14.4.0",
    "@vueuse/integrations": "14.4.0",
    "nuxt": "4.5.2",
    "reka-ui": "2.10.4",
    "sortablejs": "1.15.7",
    "valibot": "1.4.2",
    "vue": "3.5.42",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@nuxt/eslint": "1.17.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.0",
    "@types/sortablejs": "1.15.9",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/eslint-plugin": "1.6.27",
    "@vue/test-utils": "2.5.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-playwright": "2.11.0",
    "eslint-plugin-prefer-arrow-functions": "3.10.2",
    "eslint-plugin-security": "4.0.1",
    "eslint-plugin-sonarjs": "4.2.0",
    "eslint-plugin-vuejs-accessibility": "2.6.0",
    "happy-dom": "20.14.0",
    "postcss-html": "2.0.0",
    "prettier": "3.9.6",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-vue": "2.0.0",
    "typescript": "5.9.3",
    "vitest": "5.0.0",
    "vue-tsc": "3.3.11"
  }
}
