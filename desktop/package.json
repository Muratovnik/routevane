{
  "name": "routevane-desktop",
  "productName": "Routevane",
  "version": "0.0.0",
  "private": true,
  "description": "Local routing lists for routers and VPN clients",
  "license": "MIT",
  "type": "module",
  "main": "src/main.mjs",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.17.0 <12"
  },
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.mjs && node --check src/preload.cjs && node --test tests/*.test.mjs",
    "package": "node package.mjs"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "sharp": "0.35.4"
  },
  "allowScripts": {
    "electron@44.2.0": true
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
