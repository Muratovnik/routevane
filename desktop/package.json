{
  "name": "routevane-desktop",
  "productName": "Routevane",
  "version": "0.0.0",
  "private": true,
  "description": "Local routing lists for routers and VPN clients",
  "license": "MIT",
  "type": "module",
  "main": "src/main.mjs",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.17.0 <13"
  },
  "scripts": {
    "start": "electron .",
    "check": "npm run security && node --check src/main.mjs && node --check src/preload.cjs && node --test tests/*.test.mjs",
    "security": "npm audit --package-lock-only --include=dev --include=optional --include=peer --audit-level=high",
    "package": "node package.mjs"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "sharp": "0.35.5"
  },
  "allowScripts": {
    "electron@44.10.0": true
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
